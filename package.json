{
  "name": "@oedmafia/hostinger-deploy",
  "version": "1.1.0",
  "type": "module",
  "main": "dist/index.cjs",
  "bin": {
    "hostinger-deploy": "dist/index.cjs"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.cjs --format=cjs",
    "build": "tsc && npm run bundle",
    "start": "node dist/index.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/tar": "^6.1.13",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "node-ssh": "^13.2.1",
    "tar": "^7.5.22"
  }
}
